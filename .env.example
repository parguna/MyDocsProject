# SQL Server SA password — must satisfy SQL Server complexity policy (upper+lower+digit+symbol, 8+ chars)
SA_PASSWORD=ChangeMe_Sa1!

# OpenIddict signing cert / Kestrel TLS cert passphrase (one self-signed cert serves both — see README)
CERT_PASSPHRASE=ChangeMe_Cert1!

# ABP string encryption passphrase — must stay stable across restarts to decrypt already-encrypted data
STRING_ENCRYPTION_PASSPHRASE=ChangeMe_StringEnc1!

# Optional: GitHub-backed Docs project, seeded automatically by dbmigrator if RootUrl is set.
# Leave DOCS_GITHUB_TOKEN blank for a public repo.
DOCS_GITHUB_PROJECT_NAME=
DOCS_GITHUB_PROJECT_SHORT_NAME=
DOCS_GITHUB_ROOT_URL=
DOCS_GITHUB_TOKEN=
DOCS_GITHUB_LATEST_VERSION_BRANCH_NAME=master
